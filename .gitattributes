# 1. Paksa GitHub mendeteksi file YAML di dalam folder .github
.github/workflows/*.yml linguist-detectable=true
.github/workflows/*.yml linguist-language=YAML
*.yml linguist-detectable=true
*.yml linguist-language=YAML

# 2. Map file .nova ke Kotlin untuk statistik dan syntax highlighting GitHub
*.nova linguist-detectable=true
*.nova linguist-language=Kotlin
*.nova linguist-vendored=false
*.nova linguist-documentation=false

# 3. Konfigurasi bahasa pendukung lainnya
Makefile linguist-language=Makefile
Dockerfile linguist-language=Dockerfile
*.sh linguist-language=Shell
*.json linguist-language=JSON
