{
  "name": "nova-language-support",
  "displayName": "Nova Language Support",
  "description": "Language support, icon, and snippets for the Nova programming language.",
  "version": "0.1.0",
  "publisher": "nova-lang",
  "engines": {
    "vscode": ">=1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "nova",
        "aliases": ["Nova", "nova"],
        "extensions": [".nova"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "nova",
        "scopeName": "source.nova",
        "path": "./syntaxes/nova.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nova",
        "path": "./snippets.json"
      }
    ]
  }
}
